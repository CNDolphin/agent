  "questions": [
    {
      "id": 1,
      "indicator": "l1",
      "intelligence": "lang",
      "reverse": false,
      "text": "阅读时能专注投入，看过一次就能掌握内容大意，甚至能复述出来"
    },
    {
      "id": 2,
      "indicator": "l1",
      "intelligence": "lang",
      "reverse": true,
      "text": "对阅读提不起兴趣，一翻开书就容易分神，需要反复看才能记住"
    },
    {
      "id": 3,
      "indicator": "l2",
      "intelligence": "lang",
      "reverse": false,
      "text": "表达流畅准确，喜欢发言、提问、讲故事，见人爱打招呼、话比较多"
    },
    {
      "id": 4,
      "indicator": "l2",
      "intelligence": "lang",
      "reverse": true,
      "text": "话少、很少主动开口表达想法，常词不达意或说不清心里想什么"
    },
    {
      "id": 5,
      "indicator": "l3",
      "intelligence": "lang",
      "reverse": false,
      "text": "喜欢涂鸦、写字、记笔记，或用文字记录想法，写字不觉得是负担"
    },
    {
      "id": 6,
      "indicator": "l3",
      "intelligence": "lang",
      "reverse": true,
      "text": "排斥写字抄写，写作业慢、效率低，不愿用书写来表现自己"
    },
    {
      "id": 7,
      "indicator": "l4",
      "intelligence": "lang",
      "reverse": false,
      "text": "能快速抓住文章或谈话的重点，并能用自己的话重述故事情节"
    },
    {
      "id": 8,
      "indicator": "l4",
      "intelligence": "lang",
      "reverse": true,
      "text": "听过读过之后很难说出中心意思，遇到长文字理解慢、容易出错"
    },
    {
      "id": 9,
      "indicator": "l5",
      "intelligence": "lang",
      "reverse": false,
      "text": "容易被故事、电影、音乐打动，会为书中人物高兴或难过、产生共情"
    },
    {
      "id": 10,
      "indicator": "l5",
      "intelligence": "lang",
      "reverse": true,
      "text": "偏理性冷静，很少被文字或语言中的情感打动，读不出话里的情绪"
    },
    {
      "id": 11,
      "indicator": "g1",
      "intelligence": "logic",
      "reverse": false,
      "text": "喜欢推理悬疑、策略棋类游戏，遇到问题习惯先自己动脑思考解决"
    },
    {
      "id": 12,
      "indicator": "g1",
      "intelligence": "logic",
      "reverse": true,
      "text": "遇到问题先求助别人，不爱自己分析，心思单纯、不爱想问题"
    },
    {
      "id": 13,
      "indicator": "g2",
      "intelligence": "logic",
      "reverse": false,
      "text": "做事条理清晰，喜欢分门别类、归纳重点、寻找因果关系和规律"
    },
    {
      "id": 14,
      "indicator": "g2",
      "intelligence": "logic",
      "reverse": true,
      "text": "整理东西没有规则，说话做事没头绪，很难从杂乱中找到重点"
    },
    {
      "id": 15,
      "indicator": "g3",
      "intelligence": "logic",
      "reverse": false,
      "text": "能举一反三，用学过的知识解决新问题，点子多、应变快"
    },
    {
      "id": 16,
      "indicator": "g3",
      "intelligence": "logic",
      "reverse": true,
      "text": "遇到没见过的题型就手足无措，方法单一、容易钻牛角尖"
    },
    {
      "id": 17,
      "indicator": "g4",
      "intelligence": "logic",
      "reverse": false,
      "text": "口算心算好，计算不易出错，对数字、时间、钱币上手快"
    },
    {
      "id": 18,
      "indicator": "g4",
      "intelligence": "logic",
      "reverse": true,
      "text": "容易算错，不爱用心算，对数字和成本没什么概念"
    },
    {
      "id": 19,
      "indicator": "g5",
      "intelligence": "logic",
      "reverse": false,
      "text": "喜欢动手做实验，做事有计划、踏实严谨，习惯自己动手找答案"
    },
    {
      "id": 20,
      "indicator": "g5",
      "intelligence": "logic",
      "reverse": true,
      "text": "不爱动手尝试新事物，做事毛躁丢三落四，喜欢直接听结论"
    },
    {
      "id": 21,
      "indicator": "v1",
      "intelligence": "visual",
      "reverse": false,
      "text": "对图形、线条、画面敏感，记地图图表比记文字容易，爱用图像帮助记忆"
    },
    {
      "id": 22,
      "indicator": "v1",
      "intelligence": "visual",
      "reverse": true,
      "text": "很难察觉图形差异，看不懂图表，记住图像内容比较费力"
    },
    {
      "id": 23,
      "indicator": "v2",
      "intelligence": "visual",
      "reverse": false,
      "text": "在意配色，画画爱用丰富色彩，能分辨深浅、明暗的细微差别"
    },
    {
      "id": 24,
      "indicator": "v2",
      "intelligence": "visual",
      "reverse": true,
      "text": "不注重色彩搭配，画画颜色单调，常统称「黄色」而不细分鹅黄、柠檬黄"
    },
    {
      "id": 25,
      "indicator": "v3",
      "intelligence": "visual",
      "reverse": false,
      "text": "方向感好、会认路，立体图形、空间结构的东西学得快"
    },
    {
      "id": 26,
      "indicator": "v3",
      "intelligence": "visual",
      "reverse": true,
      "text": "立体图形转平面概念很困难，画不出立体透视感，不太关注形状结构"
    },
    {
      "id": 27,
      "indicator": "v4",
      "intelligence": "visual",
      "reverse": false,
      "text": "喜欢画画，常用绘画表达想法和情绪，从小爱涂涂画画"
    },
    {
      "id": 28,
      "indicator": "v4",
      "intelligence": "visual",
      "reverse": true,
      "text": "不爱画画，线条图像表现欲不强，很少主动拿起画笔"
    },
    {
      "id": 29,
      "indicator": "v5",
      "intelligence": "visual",
      "reverse": false,
      "text": "喜欢乐高、拼图、模型组装，动手组合能力强"
    },
    {
      "id": 30,
      "indicator": "v5",
      "intelligence": "visual",
      "reverse": true,
      "text": "对组合类玩具不感兴趣，搭出来的作品和心里想的差很远"
    },
    {
      "id": 31,
      "indicator": "n1",
      "intelligence": "nature",
      "reverse": false,
      "text": "能迅速察觉环境变化，喜欢观察动植物，用五官去感知大自然"
    },
    {
      "id": 32,
      "indicator": "n1",
      "intelligence": "nature",
      "reverse": true,
      "text": "对周围环境变化不敏感，不易发现图片里的细微差别"
    },
    {
      "id": 33,
      "indicator": "n2",
      "intelligence": "nature",
      "reverse": false,
      "text": "好奇心重、爱东摸摸西摸摸，会主动搜集资料、刨根问底"
    },
    {
      "id": 34,
      "indicator": "n2",
      "intelligence": "nature",
      "reverse": true,
      "text": "对外界不太感兴趣，学习比较被动，遇事喜欢别人直接给答案"
    },
    {
      "id": 35,
      "indicator": "n3",
      "intelligence": "nature",
      "reverse": false,
      "text": "能清晰分辨不同动植物和细节差异，记忆快、做事细心"
    },
    {
      "id": 36,
      "indicator": "n3",
      "intelligence": "nature",
      "reverse": true,
      "text": "常把相似的东西统称（如都叫「狗」），记不住差异，容易粗心"
    },
    {
      "id": 37,
      "indicator": "n4",
      "intelligence": "nature",
      "reverse": false,
      "text": "喜欢把物品分门别类整理，能按不同标准重新归类，讲究整洁条理"
    },
    {
      "id": 38,
      "indicator": "n4",
      "intelligence": "nature",
      "reverse": true,
      "text": "物品随手乱放，整理没有章法，不太在意归类和整洁"
    },
    {
      "id": 39,
      "indicator": "n5",
      "intelligence": "nature",
      "reverse": false,
      "text": "关心生态环境，愿意照顾小动物和植物，喜欢参与环保、分享助人"
    },
    {
      "id": 40,
      "indicator": "n5",
      "intelligence": "nature",
      "reverse": true,
      "text": "对生态环保、饲养种植不感兴趣，关注但很少付诸行动"
    },
    {
      "id": 41,
      "indicator": "m1",
      "intelligence": "music",
      "reverse": false,
      "text": "对声音和音乐敏锐，能轻易分辨不同乐器声音，听过的好歌印象深刻"
    },
    {
      "id": 42,
      "indicator": "m1",
      "intelligence": "music",
      "reverse": true,
      "text": "对声音音调变化没太大反应，同一首歌听很多次才留下印象"
    },
    {
      "id": 43,
      "indicator": "m2",
      "intelligence": "music",
      "reverse": false,
      "text": "听音乐会跟着摆动，容易受音乐感染，能用音乐表达和抒发情绪"
    },
    {
      "id": 44,
      "indicator": "m2",
      "intelligence": "music",
      "reverse": true,
      "text": "较难感受音乐里隐含的情感，很少用音乐抒发情绪"
    },
    {
      "id": 45,
      "indicator": "m3",
      "intelligence": "music",
      "reverse": false,
      "text": "能分辨音乐的风格好坏，对喜欢的音乐有自己的品味和坚持"
    },
    {
      "id": 46,
      "indicator": "m3",
      "intelligence": "music",
      "reverse": true,
      "text": "听什么都差不多，分辨不出风格差异，对音乐质量不太在意"
    },
    {
      "id": 47,
      "indicator": "m4",
      "intelligence": "music",
      "reverse": false,
      "text": "喜欢唱歌、演奏或表演，乐意在别人面前展示音乐才艺"
    },
    {
      "id": 48,
      "indicator": "m4",
      "intelligence": "music",
      "reverse": true,
      "text": "很少开口唱或当众表演音乐，对展示才艺有回避心理"
    },
    {
      "id": 49,
      "indicator": "m5",
      "intelligence": "music",
      "reverse": false,
      "text": "会哼唱自编旋律、改编歌词，喜欢自己创作音乐或用不同唱法表现"
    },
    {
      "id": 50,
      "indicator": "m5",
      "intelligence": "music",
      "reverse": true,
      "text": "极少自创音乐，不会改编节奏旋律，对音乐创作类游戏没兴趣"
    },
    {
      "id": 51,
      "indicator": "b1",
      "intelligence": "body",
      "reverse": false,
      "text": "喜欢用手触摸物品，能分辨材质粗细，手指敏锐灵活、小肌肉发展好"
    },
    {
      "id": 52,
      "indicator": "b1",
      "intelligence": "body",
      "reverse": true,
      "text": "不太在意衣物布料材质，分辨不出相似款式的质地差别"
    },
    {
      "id": 53,
      "indicator": "b2",
      "intelligence": "body",
      "reverse": false,
      "text": "反应快、手眼协调好，接抛球、躲避动作灵敏"
    },
    {
      "id": 54,
      "indicator": "b2",
      "intelligence": "body",
      "reverse": true,
      "text": "反应偏慢，接东西常落空，动作协调性一般"
    },
    {
      "id": 55,
      "indicator": "b3",
      "intelligence": "body",
      "reverse": false,
      "text": "平衡感好，走平衡木、单脚站、骑车都稳当"
    },
    {
      "id": 56,
      "indicator": "b3",
      "intelligence": "body",
      "reverse": true,
      "text": "平衡感弱，容易摔倒，跑跳动作不太稳"
    },
    {
      "id": 57,
      "indicator": "b4",
      "intelligence": "body",
      "reverse": false,
      "text": "擅长操控工具器械，拍球、投掷、骑车等动作精准有力"
    },
    {
      "id": 58,
      "indicator": "b4",
      "intelligence": "body",
      "reverse": true,
      "text": "操控器械比较笨拙，拍球投掷不准，精细操控弱"
