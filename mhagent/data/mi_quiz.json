    {
      "id": 59,
      "indicator": "b5",
      "intelligence": "body",
      "reverse": false,
      "text": "身体节奏感好，能跟着音乐节拍舞动，动作协调优美"
    },
    {
      "id": 60,
      "indicator": "b5",
      "intelligence": "body",
      "reverse": true,
      "text": "跟不上节拍，跳舞动作不协调，节奏感较差"
    },
    {
      "id": 61,
      "indicator": "s1",
      "intelligence": "social",
      "reverse": false,
      "text": "善于观察人，能从表情、语气、肢体动作猜出别人的情绪和心思"
    },
    {
      "id": 62,
      "indicator": "s1",
      "intelligence": "social",
      "reverse": true,
      "text": "不太会察言观色，经常看不懂别人语言或动作里的暗示"
    },
    {
      "id": 63,
      "indicator": "s2",
      "intelligence": "social",
      "reverse": false,
      "text": "能体会别人的感受，别人难过时自己也会跟着难受"
    },
    {
      "id": 64,
      "indicator": "s2",
      "intelligence": "social",
      "reverse": true,
      "text": "较难体会他人情绪，别人伤心时自己没什么感觉"
    },
    {
      "id": 65,
      "indicator": "s3",
      "intelligence": "social",
      "reverse": false,
      "text": "喜欢带头组织活动，小伙伴愿意听从安排，有号召力"
    },
    {
      "id": 66,
      "indicator": "s3",
      "intelligence": "social",
      "reverse": true,
      "text": "不愿出头、不喜组织，遇到事情习惯跟随别人"
    },
    {
      "id": 67,
      "indicator": "s4",
      "intelligence": "social",
      "reverse": false,
      "text": "在团体中配合度高，愿意分工合作，和同伴相处融洽"
    },
    {
      "id": 68,
      "indicator": "s4",
      "intelligence": "social",
      "reverse": true,
      "text": "团体活动里常游离在外，不愿配合分工，容易起冲突"
    },
    {
      "id": 69,
      "indicator": "s5",
      "intelligence": "social",
      "reverse": false,
      "text": "会说话、懂礼貌，能清楚表达并说服别人，交朋友容易"
    },
    {
      "id": 70,
      "indicator": "s5",
      "intelligence": "social",
      "reverse": true,
      "text": "沟通不畅，表达不清意图，和别人打交道容易产生误解"
    },
    {
      "id": 71,
      "indicator": "i1",
      "intelligence": "inner",
      "reverse": false,
      "text": "清楚自己的优点缺点，明白自己的想法和目标，知道自己要什么"
    },
    {
      "id": 72,
      "indicator": "i1",
      "intelligence": "inner",
      "reverse": true,
      "text": "不太了解自己，说不清自己的感受，容易人云亦云"
    },
    {
      "id": 73,
      "indicator": "i2",
      "intelligence": "inner",
      "reverse": false,
      "text": "做错事会自我反思，能从经验中吸取教训、改进自己"
